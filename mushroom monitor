# ================== MAIN MONITORING SYSTEM ==================
class MushroomRobotMonitor:
    def __init__(self):
        self.db = MonitoringDatabase()
        self.modbus_monitor = ModbusMonitor(MODBUS_HOST, MODBUS_PORT, self.db)
        self.mqtt_monitor = MQTTMonitor(MQTT_BROKER, MQTT_PORT, self.db)
        self.waveform_generator = WaveformGenerator(self.db)
        self.register_config = REGISTER_CONFIG
    
    def start(self, duration=None):
        """Start monitoring"""
        logger.info("="*60)
        logger.info("🚀 Mushroom Robot Monitoring System Started")
        logger.info("="*60)
        
        if not self.modbus_monitor.connect():
            logger.error("Failed to connect to Modbus")
            return
        
        if not self.mqtt_monitor.connect():
            logger.error("Failed to connect to MQTT")
            return
        
        start_time = time.time()
        
        try:
            while True:
                modbus_data = self.modbus_monitor.read_registers(self.register_config)
                
                if modbus_data:
                    logger.debug(f"📊 Modbus data: {json.dumps(modbus_data, indent=2)}")
                
                if duration and (time.time() - start_time) > duration:
                    break
                
                time.sleep(0.5)
                
        except KeyboardInterrupt:
            logger.info("\n⏹️  Monitoring stopped by user")
        finally:
            self.stop()
    
    def stop(self):
        """Stop monitoring and generate reports"""
        logger.info("Shutting down...")
        
        logger.info("Generating waveform diagrams...")
        self.waveform_generator.generate_register_waveforms(self.modbus_monitor)
        
        logger.info("Generating HTML report...")
        self.waveform_generator.generate_html_report(self.modbus_monitor, self.mqtt_monitor)
        
        self.modbus_monitor.disconnect()
        self.mqtt_monitor.disconnect()
        
        logger.info("="*60)
        logger.info("✓ Monitoring system stopped")
        logger.info("="*60)

